<Window x:Class="QuickDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:vm="clr-namespace:QuickDock.ViewModels"
        Title="QuickDock Settings"
        Width="480" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 아이콘 버튼 (✎ 편집, ✕ 삭제, ✕ 닫기) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem: 파란 기본 선택 제거, 카드 Hover/Selected 효과 -->
        <Style x:Key="BookmarkItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- 카드 하이라이트 레이어 (Hover / Selected 시 표시) -->
                            <Border x:Name="cardBg"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,2"/>
                            <!-- 컨텐츠 + 하단 구분선 -->
                            <Grid>
                                <ContentPresenter Margin="4,0"/>
                                <Rectangle x:Name="separator"
                                           Height="1" Fill="#E8E8E8"
                                           VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBg" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="cardBg" Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter TargetName="separator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBg" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="cardBg" Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter TargetName="separator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 외부 카드 (MainWindow와 동일한 패턴) -->
    <Border Background="#FFFFFF" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════ -->
            <!-- ROW 0: 타이틀 바                       -->
            <!-- ══════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="24,20,24,16"
                  MouseLeftButtonDown="TitleBar_MouseDown"
                  Cursor="SizeAll">
                <TextBlock Text="QuickDock Settings"
                           FontSize="14" FontWeight="Medium"
                           Foreground="#1A1A1A"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <TextBlock Text="✕" FontSize="15" Foreground="#AAAAAA"/>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!-- ROW 1: HOTKEY 고정 섹션               -->
            <!-- ══════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="24,0,24,16">

                <!-- HOTKEY 섹션 헤더 -->
                <TextBlock Text="HOTKEY"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#AAAAAA"
                           Margin="0,0,0,8"/>

                <!-- 단축키 카드 -->
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 설명 텍스트 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Toggle widget"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1A1A1A"/>
                            <TextBlock Text="{Binding HotkeyStatusText}"
                                       FontSize="11" Foreground="#999999"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 가운데: 키 배지 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0">
                            <Border CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1"
                                    Background="#FFFFFF" Padding="8,4">
                                <TextBlock Text="{Binding HotkeyModifierText}"
                                           FontFamily="Consolas"
                                           FontSize="13" Foreground="#1A1A1A"/>
                            </Border>
                            <TextBlock Text="+" FontSize="13" Foreground="#AAAAAA"
                                       VerticalAlignment="Center" Margin="6,0"/>
                            <Border CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1"
                                    Background="#FFFFFF" Padding="8,4">
                                <TextBlock Text="{Binding HotkeyKeyText}"
                                           FontFamily="Consolas"
                                           FontSize="13" Foreground="#1A1A1A"/>
                            </Border>
                        </StackPanel>

                        <!-- 오른쪽: Change / Save 버튼 -->
                        <Button x:Name="ChangeHotkeyButton"
                                Grid.Column="2"
                                Content="{Binding HotkeyButtonText}"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="16,8"
                                VerticalAlignment="Center"
                                Click="ChangeHotkeyButton_Click"/>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ══════════════════════════════════════ -->
            <!-- ROW 2: 스크롤 컨텐츠 (BOOKMARKS)       -->
            <!-- ══════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,16">

                    <!-- BOOKMARKS 섹션 헤더 (카운트 바인딩 포함) -->
                    <TextBlock FontSize="11" FontWeight="Medium" Foreground="#AAAAAA"
                               Margin="0,0,0,8">
                        <Run Text="BOOKMARKS · "/>
                        <Run Text="{Binding Bookmarks.Count, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 북마크 리스트 -->
                    <ListBox x:Name="BookmarkListBox"
                             ItemsSource="{Binding Bookmarks}"
                             ItemContainerStyle="{StaticResource BookmarkItemStyle}"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             PreviewMouseWheel="BookmarkListBox_PreviewMouseWheel"
                             SelectionChanged="BookmarkListBox_SelectionChanged"
                             Margin="0,0,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 드래그 핸들 -->
                                    <TextBlock Grid.Column="0"
                                               Text="⠿" FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <!-- 제목 + URL -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#1A1A1A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url, Converter={StaticResource UrlDisplayConverter}}"
                                                   FontSize="13" Foreground="#999999"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 삭제 아이콘 버튼 -->
                                    <Button Grid.Column="2"
                                            Tag="{Binding}"
                                            Click="DeleteButton_Click"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="삭제"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════ -->
            <!-- ROW 3: 편집 폼 (고정 위치)              -->
            <!-- ══════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="24,12,24,4">
                <Rectangle RadiusX="12" RadiusY="12"
                           Stroke="#D0D0D0" StrokeThickness="1"
                           StrokeDashArray="4,2" Fill="Transparent"/>
                <StackPanel Margin="16,14">
                    <!-- 이름 입력 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name"
                                   FontSize="13" Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding InputTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Foreground="#1A1A1A"
                                 BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                 Background="Transparent" Padding="4,4"/>
                    </Grid>
                    <!-- URL 입력 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="URL"
                                   FontSize="13" Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Foreground="#1A1A1A"
                                 BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                 Background="Transparent" Padding="4,4"/>
                    </Grid>
                    <!-- 아이콘 색상 선택 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Color"
                                   FontSize="13" Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="1"
                                      x:Name="IconColorPicker"
                                      ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.IconColors}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="30" Height="30" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SelectIconColorCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Width="30" Height="30">
                                                                <Border x:Name="ring"
                                                                        Width="30" Height="30"
                                                                        CornerRadius="15"
                                                                        BorderThickness="2"
                                                                        BorderBrush="#3B82F6"
                                                                        Background="Transparent"
                                                                        Visibility="Collapsed"/>
                                                                <Border Width="22" Height="22"
                                                                        CornerRadius="11"
                                                                        Background="{Binding Converter={StaticResource StringToBrushConverter}}">
                                                                    <TextBlock Text="{Binding DataContext.InputTitle,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                                      Converter={StaticResource FirstLetterConverter}}"
                                                                               FontSize="10" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource ColorMatchConverter}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.InputIconColor"
                                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!-- ROW 4: 푸터 바                         -->
            <!-- ══════════════════════════════════════ -->
            <Border Grid.Row="4" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 저장 경로 텍스트 -->
                    <TextBlock Grid.Column="0"
                               Text="%APPDATA%/QUICKDOCK/BOOKMARKS.JSON"
                               FontSize="10" Foreground="#999999"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Cancel / Save 버튼 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel"
                                Style="{StaticResource PillButtonStyle}"
                                Click="CancelButton_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding SaveButtonText}"
                                Style="{StaticResource SaveButtonStyle}"
                                IsEnabled="{Binding IsEditMode}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
