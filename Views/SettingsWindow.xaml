<Window x:Class="QuickDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="QuickDock 설정"
        Width="420" Height="520"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="⚙ QuickDock 설정"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
             x:Name="BookmarkListBox"
             ItemsSource="{Binding Bookmarks}"
             dd:DragDrop.IsDragSource="True"
             dd:DragDrop.IsDropTarget="True"
             BorderBrush="#DDDDDD"
             BorderThickness="1"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1행: 제목 + 버튼 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="1"
                               Content="수정"
                               Tag="{Binding}"
                               Click="EditButton_Click"
                               Margin="8,0,4,0"
                               Padding="10,3"
                               FontSize="11"/>

                            <Button Grid.Column="2"
                                Content="삭제"
                                Tag="{Binding}"
                                Click="DeleteButton_Click"
                                Padding="10,3"
                                FontSize="11"
                                Foreground="White"
                                Background="#E05555"/>
                        </Grid>

                        <!-- 2행: URL -->
                        <TextBlock Grid.Row="1"
                           Text="{Binding Url}"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="이름"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding InputTitle, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"
                         Padding="6,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="URL"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"
                         Padding="6,4"/>

                <StackPanel Grid.Row="2" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="취소"
                            Click="CancelButton_Click"
                            Padding="12,6"
                            Margin="0,0,6,0"/>
                    <Button Content="{Binding SaveButtonText}"
                            Click="SaveButton_Click"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="닫기"
                    Click="CloseButton_Click"
                    Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>