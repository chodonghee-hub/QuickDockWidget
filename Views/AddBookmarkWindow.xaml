<Window x:Class="QuickDock.Views.AddBookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickDock.ViewModels"
        Title="Add Bookmark"
        Width="450"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 섹션 레이블 스타일 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 아이콘 버튼 (닫기) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox 공통: 테두리/포커스 chrome 제거 -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="CaretBrush" Value="#1A1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 외부 카드 (Margin=12 for shadow room) -->
    <Border Background="#FFFFFF" CornerRadius="20" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="24,22,24,22">

            <!-- ══════════════════════════════════════ -->
            <!-- [1] 헤더                               -->
            <!-- ══════════════════════════════════════ -->
            <Grid MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Add bookmark"
                               FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Saved locally on this device."
                               FontSize="13" Foreground="#AAAAAA" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseIconButtonStyle}"
                        Click="CloseButton_Click">
                    <TextBlock Text="✕" FontSize="15" Foreground="#AAAAAA"/>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!-- [2] NAME 필드                          -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="NAME" Style="{StaticResource FieldLabelStyle}"/>
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding InputTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleCharCount}"
                               FontSize="11" Foreground="#CCCCCC"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════ -->
            <!-- [3] URL 필드                           -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="URL" Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,0,0,4">
                <!-- 점선 테두리 Rectangle 오버레이 -->
                <Rectangle RadiusX="12" RadiusY="12"
                           Stroke="#D0D0D0" StrokeThickness="1.5"
                           StrokeDashArray="4,2" Fill="White"/>
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="https://"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="#BBBBBB" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="2,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding UrlValidationText}"
                               FontSize="11" Foreground="#22C55E"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding IsUrlValid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
            <TextBlock Text="only http:// and https:// are allowed"
                       FontSize="11" Foreground="#AAAAAA" Margin="0,4,0,16"/>

            <!-- ══════════════════════════════════════ -->
            <!-- [4] ICON 선택기                        -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="ICON" Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 색상 칩 행 -->
                <ItemsControl Grid.Column="0"
                              x:Name="IconItemsControl"
                              ItemsSource="{Binding Source={x:Static vm:AddBookmarkViewModel.IconColors}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="44" Height="44" Margin="0,0,6,0"
                                    Command="{Binding DataContext.SelectIconCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="44" Height="44">
                                                        <!-- 선택 링 -->
                                                        <Border x:Name="ring"
                                                                Width="44" Height="44"
                                                                CornerRadius="22"
                                                                BorderThickness="2"
                                                                BorderBrush="#3B82F6"
                                                                Background="Transparent"
                                                                Visibility="Collapsed"/>
                                                        <!-- 색상 원 -->
                                                        <Border Width="34" Height="34"
                                                                CornerRadius="17"
                                                                Background="{Binding Converter={StaticResource StringToBrushConverter}}">
                                                            <TextBlock Text="{Binding DataContext.InputTitle,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                              Converter={StaticResource FirstLetterConverter}}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ColorMatchConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedIconColor"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- auto favicon 옵션 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <CheckBox IsChecked="{Binding IsAutoFavicon}" Cursor="Hand"
                              FocusVisualStyle="{x:Null}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="auto" FontSize="11" Foreground="#888888"/>
                                <TextBlock Text="favicon" FontSize="11" Foreground="#888888"/>
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!-- [5] GROUP 필드 (OPTIONAL)              -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="GROUP · OPTIONAL" Style="{StaticResource FieldLabelStyle}"/>
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,24">
                <Grid>
                    <!-- Placeholder 오버레이 -->
                    <TextBlock Text="e.g. Dev, Read, Design"
                               FontSize="13" Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputGroup}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding InputGroup, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════ -->
            <!-- [6] 푸터                               -->
            <!-- ══════════════════════════════════════ -->
            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 벨 + 백업 안내 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="11" Foreground="#AAAAAA" LineHeight="16" TextWrapping="Wrap">
                            <Run Text="A backup will be"/>
                            <LineBreak/>
                            <Run Text="written automatically."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 우측: Cancel + Save bookmark -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel"
                                Style="{StaticResource PillButtonStyle}"
                                Click="CancelButton_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="Save bookmark"
                                Style="{StaticResource SaveButtonStyle}"
                                FontWeight="Bold"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</Window>
