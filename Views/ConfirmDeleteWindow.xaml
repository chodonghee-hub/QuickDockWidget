<Window x:Class="QuickDock.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#FFFFFF" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="24,20">
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="#1A1A1A"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소"
                        Style="{StaticResource PillButtonStyle}"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"/>
                <Button Content="삭제"
                        Style="{StaticResource SaveButtonStyle}"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
