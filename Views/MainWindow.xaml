<Window x:Class="QuickDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="20" Padding="18,18,0,18" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Grid Grid.Row="0" Margin="0,0,18,0">
                <TextBlock Text="BOOKMARKS"
                           FontSize="11"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}"
                            Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="↑" FontSize="12" Foreground="#CCCCCC"/>
                    </Button>
                    <Button Command="{Binding NextPageCommand}"
                            Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="↓" FontSize="12" Foreground="#CCCCCC"/>
                    </Button>
                    <TextBlock Text="↵" FontSize="12" Foreground="#CCCCCC"/>
                </StackPanel>
            </Grid>

            <!-- 페이지 점 -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding PageDots}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8"
                          Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="6" Height="6" Margin="3,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="#CCCCCC"/>
                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="True">
                                            <Setter Property="Fill" Value="#AAAAAA"/>
                                            <Setter Property="Stroke" Value="#AAAAAA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 북마크 목록 -->
            <ItemsControl x:Name="BookmarkItemsControl"
                          Grid.Row="3"
                          ItemsSource="{Binding PagedBookmarks}"
                          Margin="0,0,18,0"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          PreviewKeyDown="BookmarkItemsControl_PreviewKeyDown">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMultiplePages}" Value="True">
                                <Setter Property="MinHeight" Value="468"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <!-- 단일 페이지: Collapsed로 창 높이 정상 조절 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding DataContext.HasMultiplePages, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <!-- 다중 페이지: Hidden으로 레이아웃 크기 고정 (InvalidateMeasure 없음) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding DataContext.HasMultiplePages, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Hidden"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,3"
                                Height="72"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="bg"
                                                            Background="Transparent"
                                                            CornerRadius="12"/>
                                                    <Rectangle x:Name="focusBorder"
                                                               Stroke="#CCCCCC"
                                                               StrokeDashArray="4,3"
                                                               StrokeThickness="1.5"
                                                               RadiusX="12" RadiusY="12"
                                                               Visibility="Collapsed"/>
                                                    <ContentPresenter Margin="16,0"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                                        <Setter TargetName="focusBorder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#EBEBEB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 원형 아이콘 -->
                                    <Border Grid.Column="0"
                                            Width="35" Height="35"
                                            CornerRadius="26"
                                            Background="{Binding IconPath, Converter={StaticResource StringToBrushConverter}}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource FirstLetterConverter}}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 사이트명 + URL -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A1A1A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url, Converter={StaticResource UrlDisplayConverter}}"
                                                   FontSize="10"
                                                   Foreground="#999999"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 인덱스 번호 -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Index}"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Button.Content>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 푸터 -->
            <Grid Grid.Row="5" Margin="0,0,18,0">
                <!-- 아이템 카운터 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Bookmarks.Count}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#AAAAAA"
                               LineHeight="14"/>
                    <TextBlock Text="ITEMS"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               LineHeight="14"/>
                </StackPanel>

                <!-- 설정 · 추가 버튼 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="0,0,6,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#E5E5E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="AddButton"
                            Content="＋"
                            Command="{Binding OpenAddBookmarkCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#E5E5E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
